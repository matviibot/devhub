{
  "projects": [
    {
      "id": "my-app",
      "name": "My App",
      "icon": "public/icon.svg",
      "repos": [
        {
          "path": "~/dev/my-app",
          "launchers": [
            {
              "role": "web",
              "cmd": "npm run dev",
              "dir": "apps/web",
              "policy": {
                "ports": "alloc",
                "range": [3100, 3199],
                "env": "PORT"
              }
            },
            {
              "role": "api",
              "cmd": "npm run dev",
              "dir": "services/api",
              "policy": { "ports": "fixed" }
            }
          ]
        }
      ]
    },
    {
      "id": "product",
      "name": "Product",
      "repos": [
        { "path": "~/dev/product-api", "label": "API", "launchers": [] },
        { "path": "~/dev/product-web", "label": "Web", "launchers": [] }
      ]
    }
  ]
}
